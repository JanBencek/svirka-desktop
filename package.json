{
  "name": "svirka-desktop",
  "productName": "Svirka",
  "version": "1.7.0",
  "description": "Svirka for the desktop: music.bencit.com in its own window, with media keys",
  "author": "Jan Bencek",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.bencit.svirka.desktop",
    "productName": "Svirka",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Svirka",
      "artifactName": "Svirka-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Audio"
    },
    "publish": {
      "provider": "github",
      "owner": "JanBencek",
      "repo": "svirka-desktop"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
